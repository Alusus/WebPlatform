اشمل "مـتم/ريـاضيات"؛
اشمل "مـحا"؛
مـحا.اشمل_حزمة("Alusus/WebPlatform@0.9"، "مـنصة_ويب.أسس")؛
مـحا.اشمل_حزمة("Alusus/Json@0.2"، "جـيسون.أسس")؛
اشمل "مـتم/سندات"؛
اشمل "مـتم/مـصفوفة"؛
اشمل "مـتم/نـص"؛
اشمل "مـتم/طـرفية"؛
اشمل "مغلفة"؛

استخدم مـتم؛
استخدم مـنصة_ويب؛

وحدة الـخادم {
    عرف فتحة_أ: مؤشر[مـسار_مقبس_ويب](0)؛
    عرف فتحة_ب: مؤشر[مـسار_مقبس_ويب](0)؛

    @مسار_مقبس["/chat"]
    صنف مـقبس_الدردشة {
        @حقنة عرف اتصال_مقبس: مـسار_مقبس_ويب؛

        عملية (هذا: مـسار_مقبس_ويب).عند_الجهوزية() حدد_مؤشر {
            إذا فتحة_أ == 0 {
                فتحة_أ = هذا~مؤشر؛
            } وإلا إذا فتحة_ب == 0 {
                فتحة_ب = هذا~مؤشر؛
                (فتحة_أ~محتوى).أرسل_نصا("انضم مشارك جديد إلى الدردشة.")؛
            } وإلا {
                هذا.أغلق(4000، "غرفة الدردشة ممتلئة (الحد الأقصى شخصان)")؛
            }
        }

        عملية (هذا: مـسار_مقبس_ويب).عند_استلام_بيانات(بيانات: سند[مـصفوفة[مـحرف]]، أهو_رقمي: Bool) حدد_مؤشر {
            إذا أهو_رقمي أرجع؛
            إذا هذا~مؤشر != فتحة_أ و هذا~مؤشر != فتحة_ب أرجع؛
            عرف الآخر: مؤشر[مـسار_مقبس_ويب]؛
            إذا هذا~مؤشر == فتحة_أ {
                الآخر = فتحة_ب؛
            } وإلا {
                الآخر = فتحة_أ؛
            }
            إذا الآخر != 0 {
                (الآخر~محتوى).أرسل_نصا(بيانات.صوان~مؤشر)؛
            }
        }

        عملية (هذا: مـسار_مقبس_ويب).عند_الإغلاق() : فراغ حدد_مؤشر {
            إذا هذا~مؤشر == فتحة_أ فتحة_أ = 0؛
            إذا هذا~مؤشر == فتحة_ب فتحة_ب = 0؛
        }
    }

    @مسار_موارد["/assets/"] عرف مسار_الموارد: "Assets/"؛
}

وحدة الـواجهة {
    عرف _لون_أساسي_: لـون("8e50ef")؛
    عرف _لون_فاتح_: لـون("c380ff")؛

    صنف الـترويسة {
        @حقنة عرف مركب: مـركب؛

        عملية هذا~هيئ() {
            هذا.المشهد = صـندوق({}).{
                الطراز.{
                    العرض = مـسافة.مئوي(100) - مـسافة.نقاط(3)؛
                    الطول = مـسافة.نقاط(60)؛
                    الحشوة = مـسافة4.نقاط(4، 0، 0، 0)؛
                    الخلفية = خـلفية(_لون_أساسي_)؛
                    سمك_الإطار = مـسافة4.نقاط(1.5)؛
                    طراز_الإطار = طـراز_إطار._مستمر_؛
                    لون_الإطار = _لون_أساسي_؛
                    الإظهار = إظـهار._مرن_؛
                    النسق = نـسق._سطر_؛
                    ملء_السطر = مـلء_سطر._مسافة_بينية_؛
                    المحاذاة = مـحاذاة._وسط_؛
                }؛
                أضف_فروع({
                    كـتابة(نـص("أمثلة منصة ويب الأسس - دردشة عبر المقبس")).{ الطراز.{
                        لون_الخط = لـون("fff")؛
                        حجم_الخط = مـسافة.نقاط(18.0)؛
                        الحشوة = مـسافة4.نقاط(0، 10)؛
                    } }،
                    صـورة().{
                        الرابط = نـص("/assets/wblogo.svg")؛
                        الطراز.{
                            الطول = مـسافة.نقاط(50)؛
                            الحشوة = مـسافة4.نقاط(0، 10)؛
                        }؛
                    }
                })؛
            }؛
        }

        عملية هذا_الصنف(): سـندنا[الـترويسة] {
            أرجع سـندنا[الـترويسة].أنشئ()؛
        }
    }

    صنف مـدخل_الرسالة {
        @حقنة عرف مركب: مـركب؛

        عرف عند_الإرسال: مغلفة (نـص)؛
        عرف مدخل_النص: سـندنا[مـدخل_نص]؛

        عملية هذا.العرض = سـندنا[مـسافة] {
            هذا.المشهد.الطراز.العرض = قيمة؛
            أرجع قيمة؛
        }

        عملية هذا.الطول = سـندنا[مـسافة] {
            هذا.المشهد.الطراز.الطول = قيمة؛
            أرجع قيمة؛
        }

        عملية هذا~هيئ() {
            عرف الكائن: سند[هذا_الصنف](هذا)؛

            هذا.المشهد = صـندوق({}).{
                الطراز.{
                    الإظهار = إظـهار._مرن_؛
                    النسق = نـسق._سطر_؛
                    ملء_السطر = مـلء_سطر._مسافة_بينية_؛
                    سمك_الإطار = مـسافة4.نقاط(1.5)؛
                    طراز_الإطار = طـراز_إطار._مستمر_؛
                    لون_الإطار = _لون_أساسي_؛
                    الخلفية = خـلفية(_لون_أساسي_)؛
                }؛
                أضف_فروع({
                    مـدخل_نص().{
                        الكائن.مدخل_النص = هذا؛
                        الطراز.{
                            العرض = مـسافة.مئوي(100)؛
                            الطول = مـسافة.مئوي(100)؛
                            الخلفية = خـلفية(لـون("fff"))؛
                            حجم_الخط = مـسافة.نقاط(12.0)؛
                        }؛
                        عند_انتهاء_الكبسة.اربط(مغلفة (ضبيطة: سند[مـدخل_نص]، حمولة: سند[نـص]) {
                            إذا حمولة == "Enter" {
                                عرف بيانات_جديدة: نـص = ضبيطة.هات_النص().شذب()؛
                                إذا بيانات_جديدة.هات_الطول() == 0 أرجع؛
                                ضبيطة.حدد_النص(نـص())؛
                                إذا ليس الكائن.عند_الإرسال.أهو_عدم() الكائن.عند_الإرسال(بيانات_جديدة)؛
                            }
                        })؛
                    }،
                    الـزر(نـص("أرسل")).{
                        الطراز.{
                            الطول = مـسافة.مئوي(100)؛
                            العرض = مـسافة.نقاط(50)؛
                            حدد_خامة[الخلفية](نـص("lightblue"))؛
                            حجم_الخط = مـسافة.نقاط(16.0)؛
                            ملء_السطر = مـلء_سطر._وسط_؛
                        }؛
                        عند_الضغط.اربط(مغلفة (ضبيطة: سند[ضـبيطة]، حمولة: سند[صـحيح]) {
                            عرف بيانات_جديدة: نـص = الكائن.مدخل_النص.هات_النص().شذب()؛
                            إذا بيانات_جديدة.هات_الطول() == 0 أرجع؛
                            الكائن.مدخل_النص.حدد_النص(نـص())؛
                            إذا ليس الكائن.عند_الإرسال.أهو_عدم() الكائن.عند_الإرسال(بيانات_جديدة)؛
                        })؛
                    }
                })؛
            }؛
        }

        عملية هذا_الصنف(): سـندنا[مـدخل_الرسالة] {
            أرجع سـندنا[مـدخل_الرسالة].أنشئ()؛
        }
    }

    //==============================================================================
    // صفحات الواجهة

    @منفذ_مرئي["/"]
    @عنوان["مثال منصة ويب - دردشة عبر المقبس"]
    دالة صفحة_الدردشة {
        نـافذة.النموذج.الطراز.{
            الحشوة = مـسافة4.نقاط(0)؛
            الهامش = مـسافة4.نقاط(0)؛
        }؛

        عرف نص_الحالة: سـندنا[كـتابة]؛
        عرف صندوق_السجل: سـندنا[صـندوق]؛
        عرف مدخل_الرسالة: سـندنا[مـدخل_الرسالة]؛

        نـافذة.النموذج.حدد_المشهد(صـندوق({}).{
            الطراز.{
                الطول = مـسافة.مئوي(100)؛
                ملء_السطر = مـلء_سطر._مسافة_بينية_؛
                الإظهار = إظـهار._مرن_؛
                النسق = نـسق._عمود_؛
            }؛
            أضف_فروع({
                الـترويسة()،
                صـندوق({}).{
                    الطراز.{
                        العرض = مـسافة.مئوي(100) - مـسافة.نقاط(10)؛
                        الحشوة = مـسافة4.نقاط(5)؛
                        الإظهار = إظـهار._مرن_؛
                        النسق = نـسق._عمود_؛
                        المرونة = مـرونة(1)؛
                    }؛
                    أضف_فروع({
                        كـتابة(نـص("جارٍ الاتصال...")).{
                            نص_الحالة = هذا؛
                            الطراز.{
                                العرض = مـسافة.مئوي(100)؛
                                الطول = مـسافة.نقاط(20)؛
                                لون_الخط = لـون(200، 50، 50)؛
                                حجم_الخط = مـسافة.نقاط(10.0)؛
                            }؛
                        }،
                        صـندوق({}).{
                            صندوق_السجل = هذا؛
                            الطراز.{
                                العرض = مـسافة.مئوي(100)؛
                                الطول = مـسافة.مئوي(100)؛
                                الإظهار = إظـهار._مرن_؛
                                النسق = نـسق._عمود_؛
                                الفيض_ص = فـيض._تمرير_؛
                            }؛
                        }
                    })؛
                }،
                مـدخل_الرسالة().{
                    مدخل_الرسالة = هذا؛
                    العرض = مـسافة.مئوي(100) - مـسافة.نقاط(3)؛
                    الطول = مـسافة.نقاط(50)؛
                }
            })
        })؛

        عرف أضف_رسالة: مغلفة (الرسالة: نـص، لي: Bool) = مغلفة (الرسالة: نـص، لي: Bool) {
            عرف محاذاة_السطر: مـلء_سطر؛
            عرف لون_الفقاعة: لـون؛
            عرف لون_النص: لـون؛
            إذا لي {
                محاذاة_السطر = مـلء_سطر._بداية_؛
                لون_الفقاعة = _لون_فاتح_؛
                لون_النص = لـون("fff")؛
            } وإلا {
                محاذاة_السطر = مـلء_سطر._نهاية_؛
                لون_الفقاعة = لـون("e5e5e5")؛
                لون_النص = لـون("000")؛
            }
            صندوق_السجل.أضف_فروع({
                صـندوق({}).{
                    الطراز.{
                        العرض = مـسافة.مئوي(100)؛
                        الإظهار = إظـهار._مرن_؛
                        النسق = نـسق._سطر_؛
                        ملء_السطر = محاذاة_السطر؛
                    }؛
                    أضف_فروع({
                        كـتابة(الرسالة).{
                            الطراز.{
                                الخلفية = خـلفية(لون_الفقاعة)؛
                                لون_الخط = لون_النص؛
                                الحشوة = مـسافة4.نقاط(6، 10)؛
                                الهامش = مـسافة4.نقاط(8)؛
                                نصف_قطر_الإطار = مـسافة4.نقاط(10)؛
                                أقصى_عرض = مـسافة.مئوي(70)؛
                            }؛
                        }
                    })؛
                }
            })؛
        }؛

        // تنفيذ التواصل عبر مقبس الويب مع إعادة اتصال تلقائية. تستخدم محاولات إعادة
        // الاتصال تأخيرًا تصاعديًا.

        // ضبط إعادة الاتصال: تأخير تصاعدي محدود بالقيمة القصوى تأخير_إعادة_الاتصال_الأقصى،
        // مع تذبذب عشوائي حتى لا تعيد كل الألسنة/العملاء المحاولة في نفس اللحظة عند عودة
        // الخادم.
        عرف تأخير_إعادة_الاتصال_الأساسي: طـبيعي(500)؛
        عرف تأخير_إعادة_الاتصال_الأقصى: طـبيعي(15000)؛
        عرف تذبذب_إعادة_الاتصال: طـبيعي(500)؛

        عرف محاولة_إعادة_الاتصال: صـحيح(0)؛
        عرف اتصل_بالمقبس: مغلفة()؛
        عرف جدول_إعادة_الاتصال: مغلفة()؛

        عرف العميل: عـميل_مقبس_ويب؛
        العميل.منادى_الفتح = مغلفة () {
            محاولة_إعادة_الاتصال = 0؛
            نص_الحالة.حدد_النص(نـص("الحالة: متصل"))؛
        }؛
        العميل.منادى_الرسالة = مغلفة (معلومات: سند[بـيانات_رسالة_مقبس]) {
            أضف_رسالة(معلومات.البيانات_النصية، خطأ)؛
        }؛
        العميل.منادى_الإغلاق = مغلفة (جدول_إعادة_الاتصال: كسند)&(معلومات: سند[بـيانات_إغلاق_مقبس]) {
            إذا معلومات.إغلاق_مقصود {
                // أغلق الخادم (أو نحن) الاتصال عمدًا - لا داعي لإعادة المحاولة.
                نص_الحالة.حدد_النص(نـص("الحالة: منقطع - ") + معلومات.السبب)؛
                أرجع؛
            }
            // إغلاق غير طبيعي (كإعادة تشغيل الخادم مثلًا) - أعد المحاولة بتأخير تصاعدي.
            نص_الحالة.حدد_النص(نـص("الحالة: انقطع الاتصال، جارٍ إعادة الاتصال..."))؛
            جدول_إعادة_الاتصال()؛
        }؛

        اتصل_بالمقبس = مغلفة (العميل: كسند، جدول_إعادة_الاتصال: كسند)&() {
            إذا ليس العميل.اتصل("ws://localhost:8070/chat") {
                نص_الحالة.حدد_النص(نـص("الحالة: فشل الاتصال، جارٍ إعادة المحاولة..."))؛
                جدول_إعادة_الاتصال()؛
            }
        }؛

        جدول_إعادة_الاتصال = مغلفة() {
            عرف التأخير: طـبيعي = تأخير_إعادة_الاتصال_الأساسي؛
            عرف ع: صـحيح = 0؛
            بينما ع < محاولة_إعادة_الاتصال {
                إذا التأخير >= تأخير_إعادة_الاتصال_الأقصى {
                    التأخير = تأخير_إعادة_الاتصال_الأقصى؛
                    اقطع؛
                }
                التأخير *= 2؛
                ع += 1؛
            }
            التأخير += ريـاضيات.عشوائي()~مثّل[طـبيعي] % تذبذب_إعادة_الاتصال؛
            محاولة_إعادة_الاتصال += 1؛
            ابدأ_المؤقت(التأخير، مغلفة (جـيسون: جـيسون) {
                اتصل_بالمقبس()؛
            })؛
        }؛

        اتصل_بالمقبس()؛

        مدخل_الرسالة.عند_الإرسال = مغلفة (العميل: كسند)&(بيانات_جديدة: نـص) {
            إذا ليس العميل.متصل أرجع؛
            العميل.أرسل_نصا(بيانات_جديدة.صوان)؛
            أضف_رسالة(بيانات_جديدة، صح)؛
        }؛

        نفذ_حلقة_معالجة_الأحداث()؛
    }
}

عرف وحدات_الخادم: { الـخادم، الـواجهة }؛

